# ============================================================
# USMIND Docker 部署环境变量示例
# 用法：复制本文件为 .env 后修改，docker compose 会自动读取
#   cp .env.example .env
# 生产环境务必修改：USMIND_DB_PASSWORD / USMIND_JWT_SECRET / USMIND_OSS_CIPHER_KEY
# ============================================================

# MySQL root 密码（同时是后端连接密码）
USMIND_DB_PASSWORD=root

# JWT 签名密钥（生产必须：32 字节以上随机串）
# 生成示例（Linux）：openssl rand -base64 48
USMIND_JWT_SECRET=

# OSS SecretKey 的 AES 加密密钥（生产必须：16/24/32 字节）
USMIND_OSS_CIPHER_KEY=
