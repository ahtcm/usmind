# ============================================================
# usmind 部署仓库忽略文件
# 本仓库存放编译生成的静态站点文件（部署根）
# ============================================================

# 系统文件
Thumbs.db
Desktop.ini
.DS_Store

# 日志与临时文件
*.log
*.tmp
*.swp
.cache/

# 编辑器/IDE
.idea/
.vscode/
*.iml

# 本地配置（含密钥，禁止入库）
config/
.secrets/
*.env
.env.local

# 编译缓存
dist-tmp/
build-tmp/
